# URL of the copilotkit_server.py backend (see carqna-agent). Server-side
# only (read in app/api/copilotkit/route.ts) -- do not prefix with
# NEXT_PUBLIC_, the browser never needs it directly.
# Defaults to http://localhost:8000/ if unset.
CARQNA_AGENT_URL=http://localhost:8000/

# OpenTelemetry: exports the same traces (via Next.js's built-in
# instrumentation, wired up in instrumentation.ts) to a local Jaeger
# instance, viewable at http://localhost:16686. Bare base URL, no /v1/traces
# suffix -- @vercel/otel's exporter appends that itself (contrast with
# carqna-agent's .env.example, which needs the full path).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Auth0/Okta -- @auth0/nextjs-auth0 (see
# carqna-agent/.plans/004-2026-08-09-oauth2-okta-auth-plan-DONE.md). This app,
# not carqna-agent, is what actually performs the login/token-exchange flow --
# get AUTH0_DOMAIN/AUTH0_CLIENT_ID/AUTH0_CLIENT_SECRET from the Auth0
# dashboard's Application settings.
AUTH0_DOMAIN=XXXXX
AUTH0_CLIENT_ID=XXXXX
AUTH0_CLIENT_SECRET=XXXXX

# 32-byte hex secret used to encrypt the session/transaction cookies.
# Generate with: openssl rand -hex 32
AUTH0_SECRET=XXXXX

# This app's own base URL -- used to build /auth/login, /auth/callback,
# /auth/logout. Must match an Allowed Callback/Logout URL registered on the
# Auth0 Application.
APP_BASE_URL=http://localhost:3000

# Must match carqna-agent's AUTH0_AUDIENCE exactly -- this is what makes login
# request an access token scoped to carqna-agent's API (a JWT the backend can
# verify), instead of Auth0's default opaque, unscoped token.
AUTH0_AUDIENCE=https://carqna-agent/api
